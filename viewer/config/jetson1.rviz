Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
  - Class: a2r_rviz_panels/Telemetry
    Name: Robot telemetry
    Robot Namespace: jetson1
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 24; 29; 38
    Fixed Frame: jetson1/visualization_world
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground grid (metres)
      Enabled: true
      Cell Size: 0.5
      Plane: XY
      Plane Cell Count: 40
      Color: 85; 95; 110
    - Class: rviz_default_plugins/MarkerArray
      Name: Robot model
      Enabled: true
      Topic:
        Value: /jetson1/visualization/markers
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/TF
      Name: Robot axes
      Enabled: true
      Show Axes: true
      Show Arrows: false
      Show Names: false
      Marker Scale: 2.5
      Frame Timeout: 2
    - Class: rviz_default_plugins/Image
      Name: Camera (JPEG over network)
      Enabled: true
      Topic:
        Value: /jetson1/camera/image_raw/compressed
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Queue Size: 2
      Normalize Range: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Robot view
      Target Frame: jetson1/visualization_world
      Distance: 1.4
      Pitch: 0.5
      Yaw: 0.8
      Focal Point:
        X: 0
        Y: 0
        Z: 0
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
Window Geometry:
  Camera (JPEG over network):
    collapsed: false
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: 
  Robot telemetry:
    collapsed: false
  Views:
    collapsed: false
  Width: 1400
